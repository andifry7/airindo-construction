# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah meng-commit file .env.

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/airindo_construction?schema=public"

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Auth (JWT) ───────────────────────────────────────────────
# Minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=isi-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=24h
COOKIE_NAME=airindo_session

# ── Cloudinary (gambar proyek & logo klien) ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=airindo

# ── Revalidasi cache frontend ────────────────────────────────
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# ── Seeder admin (dipakai `npm run db:seed`) ─────────────────
SEED_ADMIN_USERNAME=admin-airindo
SEED_ADMIN_PASSWORD=ganti-sebelum-produksi
SEED_ADMIN_NAME=Administrator Airindo
