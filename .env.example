# Salin menjadi .env.local lalu sesuaikan.
# File .env.local TIDAK boleh di-commit.

# Alamat API backend (server-side, dipakai saat render & build)
API_BASE_URL=http://localhost:4000

# Harus sama dengan REVALIDATE_SECRET di backend/.env
# Dipakai endpoint POST /api/revalidate
REVALIDATE_SECRET=isi-dengan-secret-yang-sama-dengan-backend
